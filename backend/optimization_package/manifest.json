{
  "package_name": "ACELO Optimization Package",
  "package_version": "1.6.0",
  "namespace": "ACELO",
  "description": "ACELO's optimization notebooks, deployed into a customer's Fabric workspace.",
  "assets": [
    {
      "domain": "approval_tracking",
      "folder": "Approvals",
      "display_name": "ACELO Cluster Approval Tracking",
      "source": "approvals/ClusterApprovalTracking.ipynb",
      "required": false,
      "resource_key": "approval_tracking_notebook_id"
    },
    {
      "domain": "cluster",
      "folder": "Cluster",
      "display_name": "ACELO Cluster Optimization",
      "source": "cluster/Clusterfabric.ipynb",
      "required": true,
      "resource_key": "cluster_notebook_id"
    },
    {
      "domain": "query",
      "folder": "Query",
      "display_name": "ACELO Query Optimization",
      "source": "query/query_optimization.ipynb",
      "required": false,
      "resource_key": "query_notebook_id"
    },
    {
      "domain": "storage",
      "folder": "Storage",
      "display_name": "ACELO Storage Optimization",
      "source": "storage/storage_optimization.ipynb",
      "required": false,
      "resource_key": "storage_notebook_id"
    }
  ]
}
