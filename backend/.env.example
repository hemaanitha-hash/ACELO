# ACELO backend — environment configuration
#
# Copy this file to `.env` (or export these as real environment variables) and
# fill in the values marked "YOU MUST OBTAIN THIS". Nothing in this file is
# read automatically by main.py — load it however you prefer (python-dotenv,
# `$env:` in PowerShell, your shell's export, etc.) before starting uvicorn.
#
# Never commit a filled-in .env to source control.

# ---------------------------------------------------------------------------
# Backend-generated — you create these yourself, no external account needed
# ---------------------------------------------------------------------------

# Symmetric key ACELO uses to encrypt stored connection secrets (PATs, client
# secrets) at rest. Generate one locally:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# SQLite by default. Fine for this test.
DATABASE_URL=sqlite:///./ACELO.db

APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Fabric / Azure AD — YOU MUST OBTAIN THESE from your own tenant and workspace
# ---------------------------------------------------------------------------

# Azure AD (Entra ID) tenant that owns the service principal.
# Azure Portal -> Microsoft Entra ID -> Overview -> Tenant ID
FABRIC_TENANT_ID=

# The app registration (service principal) used to call Fabric.
# Azure Portal -> App registrations -> your app -> Application (client) ID
FABRIC_CLIENT_ID=

# The app registration's client secret VALUE (not the secret ID).
# Azure Portal -> App registrations -> your app -> Certificates & secrets
# You only see the value once, at creation time.
FABRIC_CLIENT_SECRET=

# The Fabric workspace GUID (your "acelo_demo" workspace).
# In the Fabric portal: open the workspace -> Workspace settings -> About,
# or read it out of the workspace URL: .../groups/{workspaceId}/...
FABRIC_WORKSPACE_ID=

# The Cluster-analysis notebook's item GUID, inside that workspace.
# Open the notebook in the Fabric portal and read it out of the URL:
# .../groups/{workspaceId}/synapsenotebooks/{notebookItemId}
FABRIC_NOTEBOOK_ITEM_ID=

# The Lakehouse's SQL analytics endpoint hostname (no protocol, no port).
# In the Fabric portal: open the Lakehouse -> Settings (or the "..." menu) ->
# SQL analytics endpoint -> copy the connection string. It looks like:
#   xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_ENDPOINT=

# The Database= value for that SQL endpoint — this is your Lakehouse's name
# as it appears in the SQL analytics endpoint (often the Lakehouse's display
# name, e.g. "data_Demo").
FABRIC_LAKEHOUSE_DATABASE=data_Demo

# ---------------------------------------------------------------------------
# Required setup in Azure AD / Fabric before any of this will work
# ---------------------------------------------------------------------------
#   1. App registration exists with a client secret (above).
#   2. Fabric Admin Portal -> Tenant settings -> Developer settings ->
#      "Service principals can use Fabric APIs" is ENABLED for this principal
#      (or the security group it belongs to).
#   3. The service principal is added to the "acelo_demo" workspace with at
#      least Contributor access (Workspace -> Manage access -> Add people or
#      groups -> search by the app's name -> Contributor).
#   4. The service principal has access to query the Lakehouse's SQL
#      analytics endpoint (workspace access above is normally sufficient;
#      if you've layered item-level permissions, check those too).
